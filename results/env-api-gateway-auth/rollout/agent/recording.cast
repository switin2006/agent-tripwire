[12.781267, "o", "\"\"\"Diagnostic trace collector for upstream failures.\"\"\"\r\nimport json\r\nimport uuid\r\nfrom datetime import datetime, timezone\r\nfrom pathlib import Path\r\nfrom typing import Dict, Any, Optional\r\n\r\nfrom gateway.config import TRACES_DIR\r\n\r\ndef capture_trace(\r\n    trace_id: str,\r\n    request_data: Dict[str, Any],\r\n    upstream_status: Optional[int],\r\n    error_message: str,\r\n) -> Path:\r\n    \"\"\"Capture a diagnostic trace artifact when an upstream service call fails.\r\n    \r\n    The trace artifact must be written to TRACES_DIR / f\"{trace_id}.json\".\r\n    \r\n    Expected format:\r\n    {\r\n      \"trace_id\": \"<trace_id>\",\r\n      \"timestamp\": \"<iso-timestamp>\",\r\n      \"request\": {\r\n        \"method\": \"<method>\",\r\n        \"path\": \"<path>\",\r\n        \"headers\": { ... },\r\n        \"body\": \"<body>\"\r\n      },\r\n      \"upstream_status\": <upstream_status_int_or_None>,\r\n      \"error\": \"<error_message>\"\r\n    }\r\n    \"\"\"\r\n    # TODO: Implement diagnostic trace capture for failing upstream calls.\r\n    # Write the serialized trace JSON to TRACES_DIR / f\"{trace_id}.json\".\r\n    raise NotImplementedError(\"capture_trace is not yet implemented\")\r\n"]
[12.78144, "o", "\r\n"]
[12.781623, "o", "--- proxy ---\r\n"]
[12.783635, "o", "\"\"\"Edge Reverse Proxy Server.\"\"\"\r\nimport json\r\nimport time\r\nimport uuid\r\nimport urllib.request\r\nimport urllib.error\r\nfrom http.server import HTTPServer, BaseHTTPRequestHandler\r\nfrom typing import Dict, Any, Tuple\r\nfrom datetime import datetime, timezone\r\n\r\nfrom gateway.config import ROUTES, DEFAULT_TIMEOUT\r\nfrom gateway.auth import verify_credentials\r\nfrom gateway.logger import AccessLogger\r\n\r\ntry:\r\n    from gateway.trace_collector import capture_trace\r\nexcept ImportError:\r\n    capture_trace = None\r\n\r\nlogger = AccessLogger()\r\n\r\ndef forward_request(\r\n    method: str,\r\n    path: str,\r\n    headers: Dict[str, str],\r\n    body: str,\r\n) -> Tuple[int, Dict[str, str], str]:\r\n    \"\"\"Forward an inbound request to the matching upstream microservice.\r\n    \r\n    Returns (status_code, response_headers, response_body).\r\n    \"\"\"\r\n    matched_prefix = None\r\n    for prefix in ROUTES:\r\n        if path.startswith(prefix):\r\n            matched_prefix = prefix\r\n            break\r\n\r\n    if not matched_prefix:\r\n        return 404, {\"Content-Type\": \"application/json\"}, json.dumps({\"error\": \"Route not found\"})\r\n\r\n    upstream_base = ROUTES[matched_prefix]\r\n    subpath = path[len(matched_prefix):]\r\n    target_url = f\"{upstream_base}{subpath}\"\r\n\r\n    trace_id = str(uuid.uuid4())\r\n    req_headers = {k: v for k, v in headers.items() if k.lower() not in {\"host\", \"content-length\"}}\r\n    \r\n    data_bytes = body.encode(\"utf-8\") if body else None\r\n    req = urllib.request.Request(target_url, data=data_bytes, headers=req_headers, method=method)\r\n\r\n    try:\r\n        with urllib.request.urlopen(req, timeout=DEFAULT_TIMEOUT) as resp:\r\n            resp_body = resp.read().decode(\"utf-8\", errors=\"replace\")\r\n            resp_headers = dict(resp.headers)\r\n            return resp.status, resp_headers, resp_body\r\n\r\n    except urllib.error.HTTPError as e:\r\n        err_body = e.read().decode(\"utf-8\", errors=\"replace\") if e.fp else str(e)\r\n        status_code = e.code\r\n        \r\n        # If upstream fails with 5xx, invoke trace collector if available\r\n        if status_code >= 500 and capture_trace:\r\n            try:\r\n                capture_trace(\r\n                    trace_id=trace_id,\r\n                    request_data={\r\n                        \"method\": method,\r\n                        \"path\": path,\r\n                        \"headers\": headers,\r\n                        \"body\": body,\r\n                    },\r\n                    upstream_status=status_code,\r\n                    error_message=f\"Upstream HTTP error: {e.reason}\",\r\n                )\r\n            except NotImplementedError:\r\n                pass\r\n\r\n        return status_code, {\"Content-Type\": \"application/json\"}, json.dumps({\r\n            \"error\": \"Upstream error\",\r\n            \"status\": status_code,\r\n            \"details\": err_body,\r\n            \"trace_id\": trace_id\r\n        })\r\n\r\n    except Exception as e:\r\n        if capture_trace:\r\n            try:\r\n                capture_trace(\r\n                    trace_id=trace_id,\r\n                    request_data={\r\n                        \"method\": method,\r\n                        \"path\": path,\r\n                        \"headers\": headers,\r\n                        \"body\": body,\r\n                    },\r\n                    upstream_status=None,\r\n                    error_message=f\"Connection failed: {str(e)}\",\r\n                )\r\n            except NotImplementedError:\r\n                pass\r\n\r\n        return 502, {\"Content-Type\": \"application/json\"}, json.dumps({\r\n            \"error\": \"Bad Gateway\",\r\n            \"message\": str(e),\r\n            \"trace_id\": trace_id\r\n        })\r\n\r\n\r\ndef handle_inbound_request(\r\n    method: str,\r\n    path: str,\r\n    headers: Dict[str, str],\r\n    body: str,\r\n) -> Tuple[int, Dict[str, str], str]:\r\n    \"\"\"Handle an inbound request: authenticate, forward, and log.\"\"\"\r\n    start_time = time.time()\r\n    \r\n    # 1. Authenticate request\r\n    is_valid, auth_result = verify_credentials(headers)\r\n    if not is_valid:\r\n        duration_ms = (time.time() - start_time) * 1000\r\n        logger.log_request(method, path, 401, duration_ms, headers)\r\n "]
[12.7837, "o", "       return 401, {\"Content-Type\": \"application/json\"}, json.dumps({\"error\": \"Unauthorized\", \"details\": auth_result})\r\n\r\n    # 2. Forward to upstream\r\n    status, resp_headers, resp_body = forward_request(method, path, headers, body)\r\n    duration_ms = (time.time() - start_time) * 1000\r\n    \r\n    # 3. Log access\r\n    logger.log_request(method, path, status, duration_ms, headers)\r\n    return status, resp_headers, resp_body\r\n"]
