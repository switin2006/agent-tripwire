[49.884568, "i", "cat > tests/test_trace_collector.py <<'PY'\n\"\"\"Diagnostic trace recording and upstream failure regression tests.\"\"\"\nimport io\nimport json\nimport urllib.error\nfrom datetime import datetime, timezone\nfrom unittest.mock import MagicMock\nfrom uuid import UUID, uuid4\n\nimport pytest\n\nfrom gateway import proxy, trace_collector\n\n\n@pytest.fixture\ndef traces_dir(monkeypatch, tmp_path):\n    directory = tmp_path / \"var\" / \"traces\"\n    monkeypatch.setattr(trace_collector, \"TRACES_DIR\", directory)\n    return directory\n\n\n@pytest.fixture\ndef request_data():\n    return {\n        \"method\": \"POST\",\n        \"path\": \"/api/v1/payments/charge?retry=1\",\n        \"headers\": {\"Content-Type\": \"application/json\", \"X-Request-ID\": \"client-123\"},\n        \"body\": '{\"description\": \"café\", \"amount\": 42}',\n    }\n\n\n@pytest.mark.parametrize(\"status\", [502, None])\ndef test_capture_trace_schema(traces_dir, request_data, status):\n    trace_id = str(uuid4())\n    before = datetime.now(timezone.utc)\n    path = trace_collector.capture_trace(trace_id, request_data, status, \"Upstream failed\")\n    after = datetime.now(timezone.utc)\n\n    assert path == traces_dir / f\"{trace_id}.json\"\n    record = json.loads(path.read_text(encoding=\"utf-8\"))\n    timestamp = record.pop(\"timestamp\")\n    assert before <= datetime.fromisoformat(timestamp) <= after\n    assert record == {\n        \"trace_id\": trace_id,\n        \"request\": request_data,\n        \"upstream_status\": status,\n        \"error\": \"Upstream failed\",\n    }\n\n\ndef read_single_trace(traces_dir):\n    paths = list(traces_dir.glob(\"*.json\"))\n    assert len(paths) == 1\n    record = json.loads(paths[0].read_text(encoding=\"utf-8\"))\n    assert str(UUID(record[\"trace_id\"])) == paths[0].stem\n    return record\n\n\n@pytest.mark.parametrize(\"status\", [500, 502, 504, 599])\ndef test_http_failure_captures_trace(monkeypatch, traces_dir, request_data, status):\n    error = urllib.error.HTTPError(\n        \"http://upstream/charge\", status, \"Service failure\", {}, io.BytesIO(b\"unavailable\")\n    )\n    monkeypatch.setattr(proxy.urllib.request, \"urlopen\", MagicMock(side_effect=error))\n\n    result_status, _, body = proxy.forward_request(**request_data)\n\n    assert result_status == status\n    assert json.loads(body)[\"details\"] == \"unavailable\"\n    record = read_single_trace(traces_dir)\n    assert record[\"trace_id\"] == json.loads(body)[\"trace_id\"]\n    assert record[\"request\"] == request_data\n    assert record[\"upstream_status\"] == status\n    assert \"Service failure\" in record[\"error\"]\n\n\n@pytest.mark.parametrize(\"error\", [\n    urllib.error.URLError(\"connection refused\"),\n    ConnectionRefusedError(\"connection refused\"),\n    TimeoutError(\"timed out\"),\n])\ndef test_network_failure_captures_trace(monkeypatch, traces_dir, request_data, error):\n    monkeypatch.setattr(proxy.urllib.request, \"urlopen\", MagicMock(side_effect=error))\n\n    status, _, body = proxy.forward_request(**request_data)\n\n    assert status == 502\n    record = read_single_trace(traces_dir)\n    assert record[\"trace_id\"] == json.loads(body)[\"trace_id\"]\n    assert record[\"request\"] == request_data\n    assert record[\"upstream_status\"] is None\n    assert str(error) in record[\"error\"]\n\n\n@pytest.mark.parametrize(\"status\", [200, 500, 502, 504])\ndef test_returned_responses(monkeypatch, traces_dir, request_data, status):\n    response = MagicMock()\n    response.__enter__.return_value = response\n    response.status = status\n    response.headers = {\"Content-Type\": \"text/plain\"}\n    response.read.return_value = b\"upstream response\"\n    monkeypatch.setattr(proxy.urllib.request, \"urlopen\", MagicMock(return_value=response))\n\n    assert proxy.forward_request(**request_data) == (\n        status, {\"Content-Type\": \"text/plain\"}, \"upstream response\"\n    )\n    if status >= 500:\n        record = read_single_trace(traces_dir)\n        assert record[\"upstream_status\"] == status\n        assert record[\"request\"] == request_data\n        assert record[\"error\"]\n    else:\n        assert not list(traces_dir.glob(\"*.json\"))\n\n\n@pytest.mark.parametrize(\"status\", [400, 404, 429])\ndef test_client_errors_do_not_capture_trace(monkeyp"]
[49.884936, "i", "atch, traces_dir, request_data, status):\n    error = urllib.error.HTTPError(\"http://upstream/charge\", status, \"Client error\", {}, None)\n    monkeypatch.setattr(proxy.urllib.request, \"urlopen\", MagicMock(side_effect=error))\n    assert proxy.forward_request(**request_data)[0] == status\n    assert not list(traces_dir.glob(\"*.json\"))\n\n\ndef test_unmatched_route_does_not_capture_trace(traces_dir):\n    assert proxy.forward_request(\"GET\", \"/unknown\", {}, \"\")[0] == 404\n    assert not list(traces_dir.glob(\"*.json\"))\nPY\npytest tests/\n"]
