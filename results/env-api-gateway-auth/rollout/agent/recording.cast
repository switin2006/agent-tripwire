[50.244213, "o", "\u001b[?2004hroot@3379027cea40:/app# "]
[64.322113, "i", "python3 - <<'PY'\nimport json\nimport threading\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom gateway import proxy\nfrom gateway.config import TRACES_DIR\n\nclass FailingUpstream(BaseHTTPRequestHandler):\n    def do_GET(self):\n        self.send_response(504)\n        self.end_headers()\n        self.wfile.write(b'upstream timed out')\n\n    def log_message(self, *args):\n        pass\n\nserver = HTTPServer(('127.0.0.1', 0), FailingUpstream)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\noriginal_routes = proxy.ROUTES\ntrace_path = None\ntry:\n    proxy.ROUTES = {'/smoke': f'http://127.0.0.1:{server.server_port}'}\n    status, _, body = proxy.forward_request('GET', '/smoke/timeout', {'X-Request-ID': 'smoke'}, '')\n    assert status == 504\n    trace_id = json.loads(body)['trace_id']\n    trace_path = TRACES_DIR / f'{trace_id}.json'\n    assert trace_path.parent.as_posix() == '/app/var/traces'\n    record = json.loads(trace_path.read_text(encoding='utf-8'))\n    assert record['upstream_status'] == 504\n    assert record['trace_id'] == trace_id\n    assert record['request'] == {'method': 'GET', 'path': '/smoke/timeout', 'headers': {'X-Request-ID': 'smoke'}, 'body': ''}\n    assert record['error']\n    print('Real HTTP 504 smoke test passed: trace written to /app/var/traces and verified.')\nfinally:\n    proxy.ROUTES = original_routes\n    server.shutdown()\n    server.server_close()\n    thread.join()\n    if trace_path is not None:\n        trace_path.unlink(missing_ok=True)\nPY\n"]
