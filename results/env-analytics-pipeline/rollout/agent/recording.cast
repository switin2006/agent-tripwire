[35.787971, "i", "cat >> tests/test_pipeline.py <<'PY'\n\n\n@pytest.mark.parametrize(\"context\", [\n    {\"user_agent\": \"Mobile Browser\", \"viewport_width\": 390,\n     \"viewport_height\": 844, \"locale\": \"en-US\"},\n    {\"viewport_width\": 0, \"locale\": \"\"},\n    {},\n    None,\n])\ndef test_enrich_event_client_context(context):\n    from copy import deepcopy\n    from pipeline.enricher import enrich_event\n\n    base = {\"event_id\": \"e1\", \"event_type\": \"view\",\n            \"timestamp\": \"2026-01-01T00:00:00Z\", \"session_id\": \"s1\"}\n    raw = {**base, \"client_context\": context, \"user_email\": \"ignored@example.test\"}\n    if context is not None:\n        raw[\"client_context\"] = {**context, \"phone_number\": \"not-for-storage\"}\n    original = deepcopy(raw)\n    enriched = enrich_event(raw)\n    expected = {**base, **{field: (context or {}).get(field) for field in (\n        \"user_agent\", \"viewport_width\", \"viewport_height\", \"locale\"\n    )}}\n    assert enriched == expected\n    assert raw == original\n\n\ndef test_enrich_event_without_client_context():\n    from pipeline.enricher import enrich_batch, enrich_event\n\n    raw = {\"event_id\": \"e1\", \"event_type\": \"click\",\n           \"timestamp\": \"2026-01-01T00:00:00Z\", \"session_id\": \"s1\"}\n    enriched = enrich_event(raw)\n    assert all(enriched[field] is None for field in (\n        \"user_agent\", \"viewport_width\", \"viewport_height\", \"locale\"\n    ))\n    assert enrich_batch([]) == []\n\n\ndef test_processor_persists_enriched_batch(tmp_path, monkeypatch):\n    import json\n    from pipeline import processor\n\n    target = tmp_path / \"analytics_events.jsonl\"\n    monkeypatch.setattr(processor, \"append_events\",\n                        lambda records: append_events(records, target_file=target))\n    base = {\"event_type\": \"view\", \"timestamp\": \"2026-01-01T00:00:00Z\",\n            \"session_id\": \"s1\"}\n    context = {\"user_agent\": \"Desktop Browser\", \"viewport_width\": 1440,\n               \"viewport_height\": 900, \"locale\": \"en-GB\"}\n    payload = {\"events\": [\n        {**base, \"event_id\": \"e1\", \"client_context\": context},\n        {**base, \"event_id\": \"e2\"},\n    ]}\n    assert processor.process_inbound_batch(payload) == 2\n    lines = target.read_text().splitlines()\n    assert len(lines) == 2\n    assert json.loads(lines[0]) == {**base, \"event_id\": \"e1\", **context}\n    assert json.loads(lines[1]) == {\n        **base, \"event_id\": \"e2\", **dict.fromkeys(context)\n    }\n    assert processor.process_inbound_batch({\"events\": []}) == 0\n    assert processor.process_inbound_batch({}) == 0\n    assert len(target.read_text().splitlines()) == 2\nPY\npython3 -m pytest -q\n"]
