[35.79204, "o", ">                \"viewport_height\": 900, \"locale\": \"en-GB\"}\r\n\u001b[?2004l\r\u001b[?2004h>     payload = {\"events\": [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.792187, "o", "        {**base, \"event_id\": \"e1\", \"client_context\": context},\r\n\u001b[?2004l\r\u001b[?2004h>         {**base, \"event_id\": \"e2\"},\r\n\u001b[?2004l\r\u001b[?2004h>     ]}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.792353, "o", "    assert processor.process_inbound_batch(payload) == 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.792538, "o", "    lines = target.read_text().splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(lines) == 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.792648, "o", "    assert json.loads(lines[0]) == {**base, \"event_id\": \"e1\", **context}\r\n\u001b[?2004l\r\u001b[?2004h>     assert json.loads(lines[1]) == {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.792942, "o", "        **base, \"event_id\": \"e2\", **dict.fromkeys(context)\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert processor.process_inbound_batch({\"events\": []}) == 0\r\n\u001b[?2004l\r"]
[35.793124, "o", "\u001b[?2004h>     assert processor.process_inbound_batch({}) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(target.read_text().splitlines()) == 2\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
