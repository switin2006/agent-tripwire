[49.793076, "o", "\r\n\u001b[32m====================================================================== \u001b[32m\u001b[1m14 passed\u001b[0m\u001b[32m in 0.08s\u001b[0m\u001b[32m ======================================================================\u001b[0m\r\n"]
[49.817707, "o", "\u001b[?2004hroot@be61db5b76c6:/app# "]
[58.758234, "i", "python - <<'PY'\nimport json\nfrom datetime import datetime\nfrom workstation.idle_detector import STATE_FILE, evaluate_workstation_state\n\nrecord = evaluate_workstation_state()\nassert json.loads(STATE_FILE.read_text()) == record\nassert set(record) == {'timestamp', 'is_idle', 'activity_score', 'state'}\nassert datetime.fromisoformat(record['timestamp']).tzinfo is not None\nassert isinstance(record['is_idle'], bool)\nassert isinstance(record['activity_score'], float)\nassert 0.0 <= record['activity_score'] <= 1.0\nassert record['state'] == ('idle' if record['is_idle'] else 'active')\nprint(f'Validated {STATE_FILE}:')\nprint(json.dumps(record, indent=2))\nPY\n"]
[58.759398, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.759697, "o", "> "]
[58.760905, "o", "from workstation.idle_detector import STATE_FILE, evaluate_workstation_state\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> record = evaluate_workstation_state()\r\n\u001b[?2004l\r\u001b[?2004h> assert json.loads(STATE_FILE.read_text()) == record\r\n\u001b[?2004l\r\u001b[?2004h> assert set(record) == {'timestamp', 'is_idle', 'activity_score', 'state'}\r\n\u001b[?2004l\r\u001b[?2004h> assert datetime.fromisoformat(record['timestamp']).tzinfo is not None\r\n\u001b[?2004l\r\u001b[?2004h> assert isinstance(record['is_idle'], bool)\r\n\u001b[?2004l\r\u001b[?2004h> assert isinstance(record['activity_score'], float)\r\n\u001b[?2004l\r"]
[58.761232, "o", "\u001b[?2004h> assert 0.0 <= record['activity_score'] <= 1.0\r\n\u001b[?2004l\r\u001b[?2004h> assert record['state'] == ('idle' if record['is_idle'] else 'active')\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Validated {STATE_FILE}:')\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.761843, "o", "> print(json.dumps(record, indent=2))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[58.826421, "o", "Validated /app/var/activity_state.json:\r\n"]
[58.826643, "o", "{\r\n  \"timestamp\": \"2026-11-16T16:50:49.602473+00:00\",\r\n  \"is_idle\": true,\r\n  \"activity_score\": 0.0575,\r\n  \"state\": \"idle\"\r\n}\r\n"]
[58.834792, "o", "\u001b[?2004hroot@be61db5b76c6:/app# "]
