[19.973677, "o", "============================================================================ ERRORS ============================================================================\r\n\u001b[31m\u001b[1m___________________________________________________________ ERROR collecting tests/test_scheduler.py ___________________________________________________________\u001b[0m\r\n\u001b[31mImportError while importing test module '/app/tests/test_scheduler.py'.\r\nHint: make sure your test modules/packages have valid Python names.\r\nTraceback:\r\n/usr/local/lib/python3.11/importlib/__init__.py:126: in import_module\r\n    return _bootstrap._gcd_import(name[level:], package, level)\r\ntests/test_scheduler.py:4: in <module>\r\n    from workstation.privacy_guard import validate_metric_safety\r\nE   ModuleNotFoundError: No module named 'workstation'\u001b[0m\r\n"]
