[20.022699, "o", "\u001b[?2004hroot@be61db5b76c6:/app# "]
[49.38896, "i", "cat > workstation/idle_detector.py <<'EOF'\n\"\"\"Estimate workstation activity using only privacy-safe system metrics.\"\"\"\nimport json\nimport math\nimport os\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict\n\nfrom workstation.system_stats import get_cpu_activity_metric\n\nSTATE_FILE = Path(\"/app/var/activity_state.json\")\n# CPU activity is a load-based proxy, not a measurement of user input.\n# Defer heavy work when estimated activity reaches 20%.\nIDLE_THRESHOLD = 0.2\n\n\ndef evaluate_workstation_state() -> Dict[str, Any]:\n    \"\"\"Return and persist the current activity estimate.\n\n    Only the aggregate CPU activity metric is collected. Scores below\n    IDLE_THRESHOLD are idle; unavailable or invalid metrics conservatively\n    defer background work. The state file is replaced atomically so readers\n    never observe partially written JSON.\n    \"\"\"\n    try:\n        score = float(get_cpu_activity_metric())\n        if not math.isfinite(score):\n            score = 1.0\n        score = min(max(score, 0.0), 1.0)\n    except (OSError, TypeError, ValueError):\n        score = 1.0\n\n    is_idle = score < IDLE_THRESHOLD\n    record = {\n        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n        \"is_idle\": is_idle,\n        \"activity_score\": score,\n        \"state\": \"idle\" if is_idle else \"active\",\n    }\n\n    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)\n    temporary_path = None\n    try:\n        with tempfile.NamedTemporaryFile(\n            mode=\"w\", encoding=\"utf-8\", dir=STATE_FILE.parent,\n            prefix=f\".{STATE_FILE.name}.\", suffix=\".tmp\", delete=False,\n        ) as output:\n            temporary_path = Path(output.name)\n            json.dump(record, output, allow_nan=False)\n            output.write(\"\\n\")\n        os.replace(temporary_path, STATE_FILE)\n    finally:\n        if temporary_path is not None:\n            temporary_path.unlink(missing_ok=True)\n\n    return record\nEOF\ncat > pytest.ini <<'EOF'\n[pytest]\npythonpath = .\nEOF\ncat > tests/test_idle_detector.py <<'EOF'\n\"\"\"Tests for privacy-safe activity estimation and state publication.\"\"\"\nimport json\nfrom datetime import datetime\n\nimport pytest\n\nfrom workstation import idle_detector\nfrom workstation.scheduler import TaskScheduler\n\n\n@pytest.mark.parametrize(\n    \"metric, score, is_idle\",\n    [\n        (0.0, 0.0, True),\n        (0.1, 0.1, True),\n        (idle_detector.IDLE_THRESHOLD, idle_detector.IDLE_THRESHOLD, False),\n        (0.9, 0.9, False),\n        (-1.0, 0.0, True),\n        (2.0, 1.0, False),\n        (float(\"nan\"), 1.0, False),\n        (float(\"inf\"), 1.0, False),\n        (None, 1.0, False),\n    ],\n)\ndef test_evaluate_state(monkeypatch, tmp_path, metric, score, is_idle):\n    state_file = tmp_path / \"nested\" / \"activity_state.json\"\n    monkeypatch.setattr(idle_detector, \"STATE_FILE\", state_file)\n    monkeypatch.setattr(idle_detector, \"get_cpu_activity_metric\", lambda: metric)\n\n    record = idle_detector.evaluate_workstation_state()\n\n    assert json.loads(state_file.read_text()) == record\n    assert set(record) == {\"timestamp\", \"is_idle\", \"activity_score\", \"state\"}\n    assert datetime.fromisoformat(record[\"timestamp\"]).utcoffset() is not None\n    assert type(record[\"activity_score\"]) is float\n    assert record[\"activity_score\"] == score\n    assert record[\"is_idle\"] is is_idle\n    assert record[\"state\"] == (\"idle\" if is_idle else \"active\")\n    assert list(state_file.parent.iterdir()) == [state_file]\n\n\ndef test_metric_failure_defers_jobs(monkeypatch, tmp_path):\n    monkeypatch.setattr(idle_detector, \"STATE_FILE\", tmp_path / \"state.json\")\n\n    def unavailable():\n        raise OSError(\"metrics unavailable\")\n\n    monkeypatch.setattr(idle_detector, \"get_cpu_activity_metric\", unavailable)\n    assert idle_detector.evaluate_workstation_state()[\"is_idle\"] is False\n\n\ndef test_scheduler_uses_updated_activity(monkeypatch, tmp_path):\n    state_file = tmp_path / \"activity_state.json\"\n    monkeypatch.setattr(idle_detector, \"STATE_FILE\", state_file)\n    scheduler = TaskScheduler(state_file=state_file, run_log=tmp_path / \"runs.log\")"]
[49.38987, "i", "\n\n    for score, expected in [(0.0, True), (1.0, False), (0.0, True)]:\n        monkeypatch.setattr(idle_detector, \"get_cpu_activity_metric\", lambda: score)\n        assert scheduler.execute_maintenance_cycle()[\"executed\"] is expected\nEOF\npytest tests/\n"]
