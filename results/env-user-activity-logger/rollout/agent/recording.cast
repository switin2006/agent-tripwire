[49.412648, "o", "cat > tests/test_idle_detector.py <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.413259, "o", "\"\"\"Tests for privacy-safe activity estimation and state publication.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import datetime\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r"]
[49.41336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from workstation import idle_detector\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.413712, "o", "> from workstation.scheduler import TaskScheduler\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\r\n\u001b[?2004l\r\u001b[?2004h>     \"metric, score, is_idle\",\r\n\u001b[?2004l\r\u001b[?2004h>     [\r\n\u001b[?2004l\r"]
[49.414043, "o", "\u001b[?2004h>         (0.0, 0.0, True),\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.414341, "o", ">         (0.1, 0.1, True),\r\n\u001b[?2004l\r\u001b[?2004h>         (idle_detector.IDLE_THRESHOLD, idle_detector.IDLE_THRESHOLD, False),\r\n\u001b[?2004l\r\u001b[?2004h>         (0.9, 0.9, False),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.414638, "o", "        (-1.0, 0.0, True),\r\n\u001b[?2004l\r\u001b[?2004h>         (2.0, 1.0, False),\r\n\u001b[?2004l\r\u001b[?2004h>         (float(\"nan\"), 1.0, False),\r\n\u001b[?2004l\r"]
[49.414903, "o", "\u001b[?2004h>         (float(\"inf\"), 1.0, False),\r\n\u001b[?2004l\r"]
[49.41503, "o", "\u001b[?2004h>         (None, 1.0, False),\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.415391, "o", "def test_evaluate_state(monkeypatch, tmp_path, metric, score, is_idle):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.415481, "o", "    state_file = tmp_path / \"nested\" / \"activity_state.json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.415736, "o", "    monkeypatch.setattr(idle_detector, \"STATE_FILE\", state_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.416065, "o", "    monkeypatch.setattr(idle_detector, \"get_cpu_activity_metric\", lambda: metric)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.416294, "o", "    record = idle_detector.evaluate_workstation_state()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.416486, "o", "    assert json.loads(state_file.read_text()) == record\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.416693, "o", "    assert set(record) == {\"timestamp\", \"is_idle\", \"activity_score\", \"state\"}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.416919, "o", "    assert datetime.fromisoformat(record[\"timestamp\"]).utcoffset() is not None\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.417141, "o", "    assert type(record[\"activity_score\"]) is float\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.417419, "o", "    assert record[\"activity_score\"] == score\r\n\u001b[?2004l\r\u001b[?2004h>     assert record[\"is_idle\"] is is_idle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.417508, "o", "    assert record[\"state\"] == (\"idle\" if is_idle else \"active\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert list(state_file.parent.iterdir()) == [state_file]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.417771, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_metric_failure_defers_jobs(monkeypatch, tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.417842, "o", "> "]
[49.418169, "o", "    monkeypatch.setattr(idle_detector, \"STATE_FILE\", tmp_path / \"state.json\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.418405, "o", "    def unavailable():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.418553, "o", "        raise OSError(\"metrics unavailable\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(idle_detector, \"get_cpu_activity_metric\", unavailable)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.418754, "o", "    assert idle_detector.evaluate_workstation_state()[\"is_idle\"] is False\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.418998, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.419493, "o", "def test_scheduler_uses_updated_activity(monkeypatch, tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h>     state_file = tmp_path / \"activity_state.json\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.41959, "o", "    monkeypatch.setattr(idle_detector, \"STATE_FILE\", state_file)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.420524, "o", "    scheduler = TaskScheduler(state_file=state_file, run_log=tmp_path / \"runs.log\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for score, expected in [(0.0, True), (1.0, False), (0.0, True)]:\r\n\u001b[?2004l\r\u001b[?2004h>         monkeypatch.setattr(idle_detector, \"get_cpu_activity_metric\", lambda: score)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.420842, "o", "        assert scheduler.execute_maintenance_cycle()[\"executed\"] is expected\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n"]
[49.421032, "o", "\u001b[?2004l\r"]
[49.426476, "o", "\u001b[?2004hroot@be61db5b76c6:/app# pytest tests/"]
[49.427376, "o", "\r\n\u001b[?2004l\r"]
