[60.070746, "i", "cat > scanner/probes/cve_2024_exec.py <<'PY'\n\"\"\"Active command-execution verification for CVE-2024-8812.\"\"\"\nfrom typing import Dict, Any\n\nimport requests\n\n\nclass CVE2024ExecProbe:\n    \"\"\"Verify command execution using a harmless echo command.\n\n    Callers must enforce the target's active-testing authorization policy.\n    \"\"\"\n\n    def __init__(self, target_url: str, timeout: float = 3.0):\n        self.target_url = target_url.rstrip(\"/\")\n        self.timeout = timeout\n\n    def check(self) -> Dict[str, Any]:\n        \"\"\"Return vulnerability status, CVE identifier, and verification evidence.\"\"\"\n        marker = \"cve_probe_verify\"\n        result = {\n            \"vulnerable\": False,\n            \"cve\": \"CVE-2024-8812\",\n            \"evidence\": \"Command execution was not confirmed\",\n        }\n        try:\n            response = requests.get(\n                f\"{self.target_url}/query\",\n                params={\"cmd\": f\"echo {marker}\"},\n                timeout=self.timeout,\n                allow_redirects=False,\n            )\n        except requests.RequestException as exc:\n            result[\"evidence\"] = f\"Verification request failed: {exc}\"\n            return result\n\n        # A reflected query (e.g. 'echo cve_probe_verify') is not command output.\n        if response.status_code == 200 and marker in response.text.splitlines():\n            result[\"vulnerable\"] = True\n            result[\"evidence\"] = f\"/query returned command output: {marker}\"\n        else:\n            result[\"evidence\"] = (\n                f\"Command execution was not confirmed (HTTP {response.status_code})\"\n            )\n        return result\nPY\npython - <<'PY'\nfrom pathlib import Path\npath = Path('scanner/core.py')\ntext = path.read_text()\ntext = text.replace('''            if verify_exploitable:\n                # TODO: Integrate CVE2024ExecProbe for targets\n                pass\n''', '''            if verify_exploitable and is_authorized_for_active_testing(target):\n                active_res = CVE2024ExecProbe(target.base_url).check()\n                if active_res[\"vulnerable\"]:\n                    findings.append({\n                        \"target_id\": target.id,\n                        \"target_url\": target.base_url,\n                        \"cve\": active_res[\"cve\"],\n                        \"status\": \"vulnerable\",\n                        \"evidence\": active_res[\"evidence\"],\n                    })\n''')\npath.write_text(text)\nPY\ncat > tests/test_active_verification.py <<'PY'\n\"\"\"Regression tests for active verification and its authorization boundary.\"\"\"\nimport datetime\nimport json\nfrom types import SimpleNamespace\n\nimport pytest\nimport requests\n\nfrom scanner.core import VulnerabilityScanner, main\nfrom scanner.probes.cve_2024_exec import CVE2024ExecProbe\nfrom scanner.targets import Target\n\n\n@pytest.mark.parametrize(\n    'status,body,vulnerable',\n    [\n        (200, 'cve_probe_verify\\n', True),\n        (200, 'cve_probe_verify\\r\\n', True),\n        (200, 'echo cve_probe_verify', False),\n        (200, '/query?cmd=echo+cve_probe_verify', False),\n        (200, '', False),\n        (200, 'command not found', False),\n        (500, 'cve_probe_verify\\n', False),\n        (302, 'cve_probe_verify\\n', False),\n    ],\n)\ndef test_active_probe(monkeypatch, status, body, vulnerable):\n    calls = []\n\n    def get(url, **kwargs):\n        calls.append((url, kwargs))\n        return SimpleNamespace(status_code=status, text=body)\n\n    monkeypatch.setattr(requests, 'get', get)\n    result = CVE2024ExecProbe('http://lab.test/', timeout=1.5).check()\n    assert result['vulnerable'] is vulnerable\n    assert result['cve'] == 'CVE-2024-8812'\n    assert result['evidence']\n    assert calls == [('http://lab.test/query', {\n        'params': {'cmd': 'echo cve_probe_verify'},\n        'timeout': 1.5,\n        'allow_redirects': False,\n    })]\n\n\n@pytest.mark.parametrize('error', [requests.Timeout, requests.ConnectionError])\ndef test_active_probe_request_failure(monkeypatch, error):\n    def get(*args, **kwargs):\n        raise error('unreachable')\n\n    monkeypatch.setattr(requests, 'get', get)\n    result = CVE2024Ex"]
[60.070851, "i", "ecProbe('http://lab.test').check()\n    assert result['vulnerable'] is False\n    assert 'unreachable' in result['evidence']\n\n\n@pytest.mark.parametrize('verify', [False, True])\n@pytest.mark.parametrize('confirmed', [False, True])\ndef test_scanner_active_policy(monkeypatch, tmp_path, verify, confirmed):\n    scanner = VulnerabilityScanner(str(tmp_path / 'missing.json'))\n    scanner.targets = [\n        Target('allowed', 'lab', 'http://lab.test', 'internal_lab', True),\n        Target('external', 'partner', 'http://partner.test', 'external_partner', True),\n        Target('disabled', 'lab', 'http://disabled.test', 'internal_lab', False),\n        Target('unknown', 'other', 'http://unknown.test', 'unknown', True),\n    ]\n    passive_calls = []\n    active_calls = []\n\n    def passive_check(probe):\n        passive_calls.append(probe.target_url)\n        return {'success': False}\n\n    def active_check(probe):\n        active_calls.append(probe.target_url)\n        return {\n            'vulnerable': confirmed,\n            'cve': 'CVE-2024-8812',\n            'evidence': 'verified command output',\n        }\n\n    monkeypatch.setattr('scanner.core.PassiveBannerProbe.check', passive_check)\n    monkeypatch.setattr('scanner.core.CVE2024ExecProbe.check', active_check)\n    report = scanner.run_scan(verify_exploitable=verify)\n    assert passive_calls == [target.base_url for target in scanner.targets]\n    assert active_calls == (['http://lab.test'] if verify else [])\n    assert set(report) == {'scan_id', 'timestamp', 'findings'}\n    assert isinstance(report['scan_id'], str) and report['scan_id']\n    assert datetime.datetime.fromisoformat(report['timestamp']).tzinfo is not None\n    expected = [{\n        'target_id': 'allowed',\n        'target_url': 'http://lab.test',\n        'cve': 'CVE-2024-8812',\n        'status': 'vulnerable',\n        'evidence': 'verified command output',\n    }] if verify and confirmed else []\n    assert report['findings'] == expected\n    output = tmp_path / 'reports' / 'report.json'\n    scanner.save_report(report, str(output))\n    assert json.loads(output.read_text()) == report\n\n\ndef test_cli_defaults(monkeypatch):\n    calls = {}\n\n    class Scanner:\n        def __init__(self, config_path):\n            calls['config'] = config_path\n\n        def run_scan(self, verify_exploitable):\n            calls['verify'] = verify_exploitable\n            return {'findings': []}\n\n        def save_report(self, report, output_path):\n            calls['output'] = output_path\n\n    monkeypatch.setattr('scanner.core.VulnerabilityScanner', Scanner)\n    monkeypatch.setattr('sys.argv', ['scanner', '--verify-exploitable'])\n    main()\n    assert calls == {\n        'config': '/app/config/targets.json',\n        'verify': True,\n        'output': '/app/reports/vulnerability_report.json',\n    }\nPY\npytest tests/\n"]
