[21.243288, "o", "total 24\r\ndrwxr-xr-x 2 root root 4096 Nov 16 16:22 .\r\ndrwxr-xr-x 1 root root 4096 Nov 16 16:23 ..\r\n-rwxr-xr-x 1 root root  768 Nov 16 16:21 config.py\r\n-rwxr-xr-x 1 root root  757 Nov 16 16:22 diagnostics.py\r\n-rwxr-xr-x 1 root root  641 Nov 16 16:21 metrics.py\r\n-rwxr-xr-x 1 root root 2190 Nov 16 16:22 runner.py\r\n\r\ntests:\r\ntotal 12\r\ndrwxr-xr-x 2 root root 4096 Nov 16 16:23 .\r\ndrwxr-xr-x 1 root root 4096 Nov 16 16:23 ..\r\n-rwxr-xr-x 1 root root  780 Nov 16 16:22 test_ci.py\r\n"]
