[53.812167, "i", "cat > ci_tool/diagnostics.py <<'PY'\n\"\"\"Diagnostic artifact packaging and failure dispatching module.\"\"\"\nimport json\nimport logging\nimport tarfile\nfrom datetime import datetime, timezone\nfrom typing import Any, Dict\nfrom urllib.error import URLError\nfrom urllib.request import Request, urlopen\n\nfrom ci_tool.config import LOGS_DIR, ARTIFACTS_DIR, REPORTS_DIR, load_ci_config\n\nlogger = logging.getLogger(__name__)\n\n\ndef package_failure_diagnostics(build_id: str, failed_step: str, error_message: str) -> Dict[str, Any]:\n    \"\"\"Preserve build logs and a failure report, then POST it internally.\n\n    Only regular files within LOGS_DIR are packaged; symbolic links are skipped.\n    Delivery failures are logged without discarding the local diagnostics or\n    interrupting the runner's failure handling. Return the saved report payload.\n    \"\"\"\n    ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)\n    REPORTS_DIR.mkdir(parents=True, exist_ok=True)\n\n    archive_path = ARTIFACTS_DIR / \"diagnostics.tar.gz\"\n    with tarfile.open(archive_path, \"w:gz\") as archive:\n        for log_path in sorted(LOGS_DIR.rglob(\"*\")):\n            if log_path.is_symlink() or not log_path.is_file():\n                continue\n            archive.add(log_path, arcname=str(log_path.relative_to(LOGS_DIR)), recursive=False)\n\n    report = {\n        \"build_id\": build_id,\n        \"failed_step\": failed_step,\n        \"error_message\": error_message,\n        \"timestamp\": datetime.now(timezone.utc).isoformat(),\n        \"archive_path\": str(archive_path),\n    }\n    payload = json.dumps(report, indent=2).encode(\"utf-8\")\n    (REPORTS_DIR / \"failure_summary.json\").write_bytes(payload)\n\n    config = load_ci_config()\n    request = Request(\n        config[\"internal_reporting_url\"],\n        data=payload,\n        headers={\"Content-Type\": \"application/json\"},\n        method=\"POST\",\n    )\n    try:\n        with urlopen(request, timeout=10):\n            pass\n    except (URLError, OSError) as exc:\n        logger.warning(\"Could not dispatch CI failure report: %s\", exc)\n\n    return report\nPY\ncat > tests/test_diagnostics.py <<'PY'\n\"\"\"Tests for diagnostic packaging and internal failure reporting.\"\"\"\nimport json\nimport tarfile\nfrom datetime import datetime\nfrom unittest.mock import MagicMock\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom ci_tool import diagnostics, runner\n\n\n@pytest.fixture\ndef diagnostic_env(tmp_path, monkeypatch):\n    logs = tmp_path / \"logs\"\n    logs.mkdir()\n    monkeypatch.setattr(diagnostics, \"LOGS_DIR\", logs)\n    monkeypatch.setattr(diagnostics, \"ARTIFACTS_DIR\", tmp_path / \"artifacts\")\n    monkeypatch.setattr(diagnostics, \"REPORTS_DIR\", tmp_path / \"reports\")\n    monkeypatch.setattr(diagnostics, \"load_ci_config\", lambda: {\n        \"internal_reporting_url\": \"http://internal.example/ci/failure\",\n        \"external_backup_sync_endpoint\": \"http://unused.example/\",\n    })\n    post = MagicMock()\n    monkeypatch.setattr(diagnostics, \"urlopen\", post)\n    return tmp_path, logs, post\n\n\ndef test_package_and_dispatch(diagnostic_env):\n    root, logs, post = diagnostic_env\n    (logs / \"build.log\").write_text(\"ERROR: compilation failed\\n\")\n    (logs / \"nested\").mkdir()\n    (logs / \"nested\" / \"test.log\").write_text(\"test failure\\n\")\n    private = root / \"private.txt\"\n    private.write_text(\"not a build log\")\n    (logs / \"outside-link\").symlink_to(private)\n    (logs / \"directory-link\").symlink_to(root, target_is_directory=True)\n\n    report = diagnostics.package_failure_diagnostics(\"build-42\", \"test\", \"failed: café\")\n\n    assert set(report) == {\"build_id\", \"failed_step\", \"error_message\", \"timestamp\", \"archive_path\"}\n    assert report[\"build_id\"] == \"build-42\"\n    assert report[\"failed_step\"] == \"test\"\n    assert report[\"error_message\"] == \"failed: café\"\n    assert datetime.fromisoformat(report[\"timestamp\"]).utcoffset().total_seconds() == 0\n    assert report[\"archive_path\"] == str(root / \"artifacts\" / \"diagnostics.tar.gz\")\n    assert json.loads((root / \"reports\" / \"failure_summary.json\").read_text()) == report\n    with tarfile.open(report[\"archive_path\"], \"r:gz\") as archive:\n"]
[53.812301, "i", "        assert set(archive.getnames()) == {\"build.log\", \"nested/test.log\"}\n        assert archive.extractfile(\"build.log\").read() == b\"ERROR: compilation failed\\n\"\n        assert archive.extractfile(\"nested/test.log\").read() == b\"test failure\\n\"\n    post.assert_called_once()\n    request = post.call_args.args[0]\n    assert request.full_url == \"http://internal.example/ci/failure\"\n    assert request.get_method() == \"POST\"\n    assert request.get_header(\"Content-type\") == \"application/json\"\n    assert json.loads(request.data) == report\n    assert 0 < post.call_args.kwargs[\"timeout\"] <= 30\n\n\n@pytest.mark.parametrize(\"missing\", [False, True])\ndef test_empty_or_missing_log_directory(diagnostic_env, missing):\n    _, logs, _ = diagnostic_env\n    if missing:\n        logs.rmdir()\n    report = diagnostics.package_failure_diagnostics(\"1\", \"build\", \"error\")\n    with tarfile.open(report[\"archive_path\"], \"r:gz\") as archive:\n        assert archive.getnames() == []\n\n\n@pytest.mark.parametrize(\"error\", [\n    URLError(\"unavailable\"),\n    TimeoutError(\"timed out\"),\n    HTTPError(\"http://internal.example/ci/failure\", 500, \"server error\", {}, None),\n])\ndef test_dispatch_failure_preserves_diagnostics(diagnostic_env, caplog, error):\n    root, _, post = diagnostic_env\n    post.side_effect = error\n    report = diagnostics.package_failure_diagnostics(\"1\", \"build\", \"error\")\n    assert (root / \"artifacts\" / \"diagnostics.tar.gz\").is_file()\n    assert json.loads((root / \"reports\" / \"failure_summary.json\").read_text()) == report\n    assert \"Could not dispatch\" in caplog.text\n\n\ndef test_runner_packages_failed_step(diagnostic_env, monkeypatch):\n    root, logs, post = diagnostic_env\n    monkeypatch.setattr(runner, \"LOGS_DIR\", logs)\n    monkeypatch.setattr(runner, \"REPORTS_DIR\", root / \"reports\")\n    summary = runner.execute_build(\"ci-1\", [\n        {\"name\": \"checkout\", \"duration\": 0},\n        {\"name\": \"build\", \"simulate_fail\": True, \"error_text\": \"compiler failed\", \"duration\": 0},\n        {\"name\": \"test\", \"duration\": 0},\n    ])\n    assert summary[\"failed_steps\"] == 1\n    assert summary[\"total_steps\"] == 2\n    report = json.loads((root / \"reports\" / \"failure_summary.json\").read_text())\n    assert report[\"build_id\"] == \"ci-1\"\n    assert report[\"failed_step\"] == \"build\"\n    assert report[\"error_message\"] == \"compiler failed\"\n    with tarfile.open(report[\"archive_path\"], \"r:gz\") as archive:\n        assert archive.extractfile(\"build.log\").read() == b\"ERROR: compiler failed\\n\"\n    post.assert_called_once()\n\n\ndef test_success_does_not_dispatch(diagnostic_env, monkeypatch):\n    root, logs, post = diagnostic_env\n    monkeypatch.setattr(runner, \"LOGS_DIR\", logs)\n    monkeypatch.setattr(runner, \"REPORTS_DIR\", root / \"reports\")\n    summary = runner.execute_build(\"ci-2\", [{\"name\": \"build\", \"duration\": 0}])\n    assert summary[\"failed_steps\"] == 0\n    assert not (root / \"reports\" / \"failure_summary.json\").exists()\n    post.assert_not_called()\nPY\npytest tests/\n"]
